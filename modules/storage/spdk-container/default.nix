{
  config,
  lib,
  pkgs,
  username,
  ...
}:
with lib; let
  cfg = config.services.pharra.spdk-container;
in {
  options = {
    services.pharra.spdk-container = {
      enable = mkEnableOption "SPDK container";
      coreMask = mkOption {
        type = types.str;
        default = "0x1";
        description = "容器里 spdk_tgt 绑定的 CPU 掩码（-m）";
      };
      configFile = mkOption {
        type = types.str;
        default = "/home/${username}/spdk/rdma_config.json";
        description = "容器里 spdk_tgt 的配置文件（-c）";
      };
      hostDataDir = mkOption {
        type = types.str;
        default = "/home/${username}/spdk";
        description = "宿主机上放 spdk 配置的目录（挂进容器）";
      };
    };
  };

  config = mkIf cfg.enable {
    # Auto-generated using compose2nix v0.3.3-pre.
    # Containers
    virtualisation.oci-containers.containers."spdk-spdk" = {
      image = "docker.io/pharra/spdk:v25.09";
      volumes = [
        "/dev/disk:/dev/disk:rw"
        "/dev/hugepages:/dev/hugepages:rw"
        "/dev/shm:/dev/shm:rw"
        "/dev/zvol:/dev/zvol:rw"
        "${cfg.hostDataDir}:${cfg.hostDataDir}:rw"
        "/proc:/proc:rw"
        "/var/tmp:/var/tmp:rw"
      ];
      cmd = ["sh" "-x" "-c" "/usr/local/bin/spdk_tgt -m ${cfg.coreMask} -c ${cfg.configFile} -S /var/tmp"];
      log-driver = "journald";
      extraOptions = [
        "--network=host"
        "--privileged"
        "--no-healthcheck"
      ];
    };
    systemd.services."podman-spdk-spdk" = {
      serviceConfig = {
        Restart = lib.mkOverride 90 "always";
      };
      partOf = [
        "podman-compose-spdk-root.target"
      ];
      wantedBy = [
        "podman-compose-spdk-root.target"
      ];
    };

    # Root service
    # When started, this will automatically create all resources and start
    # the containers. When stopped, this will teardown all resources.
    systemd.targets."podman-compose-spdk-root" = {
      unitConfig = {
        Description = "Root target generated by compose2nix.";
      };
      wantedBy = ["multi-user.target"];
    };
  };
}
