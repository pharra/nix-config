// DMS Window Rules - Managed by Dux Shell
// Do not edit manually - changes may be overwritten

// @id=wr_1785224982325241455 @name=com.danklinux.dms
window-rule {
    match app-id="^com.danklinux.dms$"
    opacity 0.80
}

// @id=wr_1785309859728630997 @name=org.telegram.desktop
window-rule {
    match app-id="^org.telegram.desktop$" title="^媒体查看器$"
    open-floating true
    default-column-width { fixed 1920; }
    default-window-height { fixed 1080; }
    default-floating-position x=0 y=0
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    open-floating true
}

// @id=dms-window-opaque @name=DMS Window Opaque
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    opacity 1.00
}
